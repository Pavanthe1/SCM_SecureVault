# Copy these values into your hosting provider's environment settings.
# Generate a long random value for SECUREVAULT_SECRET; do not use the example in production.
SECUREVAULT_SECRET=replace-with-a-long-random-secret
SECUREVAULT_DB=/persistent/securevault.db
SECUREVAULT_ENCRYPTED_DIR=/persistent/encrypted_files
SECUREVAULT_DECRYPTED_DIR=/persistent/decrypted_files
HOST=0.0.0.0
PORT=5000
SECURE_COOKIE=1
